{
  "manifest_version": 3,
  "name": "贴进去 · PasteBridge",
  "version": "2.1.1",
  "description": "把代码和文本送进任何输入框——代码编辑器、聊天框、富文本框都行；插不进去时还能模拟键盘键入。",
  "minimum_chrome_version": "102",
  "permissions": ["scripting", "activeTab", "storage", "contextMenus"],
  "optional_permissions": ["clipboardRead", "clipboardWrite", "debugger"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background/sw.js"
  },
  "action": {
    "default_title": "贴进去 · 插入或取用",
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "打开「贴进去」面板"
    },
    "capture-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "把页面选中文本存入剪贴板历史"
    },
    "insert-latest": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "把最近一条内容插入当前编辑器"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
