{
  "manifest_version": 3,
  "name": "贴进去 · PasteBridge",
  "version": "1.0.0",
  "description": "绕过禁用粘贴的代码编辑器，把代码直接送进 CodeMirror / Monaco / Ace。",
  "minimum_chrome_version": "102",
  "permissions": ["scripting", "activeTab", "storage"],
  "action": {
    "default_title": "插入代码到编辑器",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
